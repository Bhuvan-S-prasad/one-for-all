      "isDeleted": false,
      "boundElements": [],
      "updated": 1731000000000,
      "link": null,
      "locked": false,
      "text": "Sandbox service [server.mjs] · Bearer token\n\nPOST /exec · /files/read · /files/write · /files/list\nPOST /browser · /open · /apps · /restart\nPOST /takeover (a person has the computer)\nGET  /cdp/<agent>  (DevTools over a pipe)\nGET  /desktop/<agent>  (VNC)\n\nthe only process that runs as root",
      "originalText": "Sandbox service [server.mjs] · Bearer token\n\nPOST /exec · /files/read · /files/write · /files/list\nPOST /browser · /open · /apps · /restart\nPOST /takeover (a person has the computer)\nGET  /cdp/<agent>  (DevTools over a pipe)\nGET  /desktop/<agent>  (VNC)\n\nthe only process that runs as root",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "service",
      "autoResize": true,
      "lineHeight": 1.25,
