# ─────────────────────────────────────────────────────────────
# One-for-All .gitignore
# Rule of thumb: commit source, config, migrations and docs;
# never commit secrets, generated output or local runtime data.
# ─────────────────────────────────────────────────────────────

# ── Secrets and credentials (never commit) ──────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
*.cer
# Local vault master key and exported secrets (packages/vault)
*.vault-key
vault-key*
secrets/
# EAS / Google service credentials
credentials.json
google-services.json
GoogleService-Info.plist
service-account*.json

# ── Dependencies ────────────────────────────────────────────
node_modules/
.pnpm-store/
.pnp.*
.yarn/

# ── Build output ────────────────────────────────────────────
dist/
build/
out/
*.tsbuildinfo
.vite/
.turbo/
.cache/
.eslintcache
.stylelintcache

# ── Tests, coverage and evals output ────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/
# Eval runs produce transcripts and reports; fixtures and suites are committed
evals/**/results/
evals/**/reports/
evals/**/.runs/
# Throwaway check scripts beside the code (e.g. src/screen-check.tmp.ts)
*.tmp.ts

# ── Expo / React Native (apps/mobile) ───────────────────────
.expo/
.expo-shared/
expo-env.d.ts
web-build/
.metro-health-check*
# Native projects are generated by `expo prebuild` (Continuous Native Generation)
apps/mobile/ios/
apps/mobile/android/
*.ipa
*.apk
*.aab
*.orig.*

# ── Tauri (future desktop app) ──────────────────────────────
src-tauri/target/

# ── Local runtime data (Docker volumes, databases, sandbox) ─
.data/
infra/compose/data/
infra/compose/volumes/
# Postgres dumps from backup.sh
backups/
*.dump
*.sql.gz
# Inngest dev server state
.inngest/
# Agent sandbox workspaces and browser profiles mounted locally
sandbox-data/
browser-profiles/
# Local trace stores (Phoenix) and model caches (Ollama)
.phoenix/
.ollama/

# ── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Tool caches ─────────────────────────────────────────────
# graft code-index cache (local only)
graft/
# Claude Code: shared settings are committed, personal ones are not
.claude/
CLAUDE.local.md
.gemini/
.kiro/

# ── Editors and OS ──────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Design-check screenshots and reports (local only)
.taste-skill/
