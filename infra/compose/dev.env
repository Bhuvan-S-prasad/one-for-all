# Settings for the development stack (docker-compose.dev.yml), passed with
# --env-file by `pnpm infra:*`. Without it, Compose would read `.env` in this
# folder, which holds the self-host bundle's secrets (infra/scripts/init-env.sh),
# and the dev sandbox and Postgres would take those instead of the dev defaults.
#
# Everything has a dev default in the compose file; set a value here only to
# change it (ports, for example), and match it in the root .env.
# POSTGRES_PORT=5432
# SANDBOX_TOKEN=ofa-sandbox-dev-token
