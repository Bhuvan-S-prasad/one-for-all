# The dock at the bottom of each agent's desktop (ADR-0040): launchers, open
# windows and a clock, in the app's dark colours with lime for the active one.

# Background 1: the dock and tooltips
rounded = 12
border_width = 1
border_sides = TBLR
background_color = #161618 100
border_color = #26262a 100
background_color_hover = #161618 100
border_color_hover = #26262a 100

# Background 2: the active window
rounded = 8
border_width = 1
border_sides = TBLR
background_color = #d4ff3a 18
border_color = #d4ff3a 70
background_color_hover = #d4ff3a 26
border_color_hover = #d4ff3a 90

# Background 3: other windows
rounded = 8
border_width = 0
background_color = #26262a 70
border_color = #26262a 0
background_color_hover = #303036 100
border_color_hover = #303036 0

# Panel
panel_items = LTC
panel_size = 100% 48
panel_margin = 0 10
panel_padding = 10 6 8
panel_background_id = 1
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
panel_shrink = 1
autohide = 0
strut_policy = follow_size
wm_menu = 0
panel_dock = 0
disable_transparency = 1
mouse_effects = 1
font_shadow = 0

# Open windows
taskbar_mode = single_desktop
taskbar_padding = 0 0 6
taskbar_background_id = 0
taskbar_active_background_id = 0
taskbar_name = 0
task_icon = 1
task_text = 1
task_centered = 1
task_maximum_size = 200 34
task_padding = 8 4 6
task_font = Noto Sans 9
task_font_color = #a8a8ad 100
task_active_font_color = #f4f4f0 100
task_icon_asb = 100 0 0
task_background_id = 3
task_active_background_id = 2
task_iconified_background_id = 3
task_tooltip = 1
mouse_left = toggle_iconify
mouse_middle = none
mouse_right = close
mouse_scroll_up = none
mouse_scroll_down = none

# Launchers
launcher_padding = 2 0 6
launcher_background_id = 0
launcher_icon_background_id = 0
launcher_icon_size = 30
launcher_icon_theme = Adwaita
launcher_icon_theme_override = 0
launcher_tooltip = 1
launcher_item_app = /usr/share/applications/one-for-all-terminal.desktop
launcher_item_app = /usr/share/applications/one-for-all-files.desktop
launcher_item_app = /usr/share/applications/one-for-all-browser.desktop
launcher_item_app = /usr/share/applications/one-for-all-editor.desktop

# Clock
time1_format = %H:%M
time1_font = Noto Sans Bold 10
clock_font_color = #f4f4f0 100
clock_padding = 8 0
clock_background_id = 0
clock_tooltip = %A %d %B %Y

# Tooltips
tooltip_show_timeout = 0.4
tooltip_hide_timeout = 0.1
tooltip_padding = 8 5
tooltip_background_id = 1
tooltip_font = Noto Sans 9
tooltip_font_color = #f4f4f0 100
