#!/bin/sh
# The desktop's terminal (ADR-0040): xterm attached to the agent's tmux
# session "main", started if it isn't running. Extra arguments run in it.
exec xterm -title Terminal -class Terminal \
  -fa Monospace -fs 10 -bg '#0e0e0f' -fg '#f4f4f0' -cr '#d4ff3a' \
  -geometry 110x30 -bc -sl 0 +sb -u8 \
  -e tmux new-session -A -s main "$@"
