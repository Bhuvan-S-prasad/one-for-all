# The desktop's window frames (ADR-0040): the app's dark colours, a lime edge
# on the active window. Keys left out take Openbox's defaults.
border.width: 1
padding.width: 8
padding.height: 5
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0
window.label.text.justify: center

window.active.border.color: #d4ff3a
window.inactive.border.color: #26262a
window.active.title.separator.color: #26262a
window.inactive.title.separator.color: #26262a
window.active.title.bg: flat solid
window.active.title.bg.color: #161618
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #0e0e0f
window.active.label.bg: parentrelative
window.inactive.label.bg: parentrelative
window.active.label.text.color: #f4f4f0
window.inactive.label.text.color: #a8a8ad

window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: #f4f4f0
window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #26262a
window.active.button.hover.image.color: #d4ff3a
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #303036
window.active.button.pressed.image.color: #d4ff3a
window.active.button.disabled.bg: parentrelative
window.active.button.disabled.image.color: #5c5c61
window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: #a8a8ad
window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #26262a
window.inactive.button.hover.image.color: #f4f4f0
window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #303036
window.inactive.button.pressed.image.color: #f4f4f0
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.disabled.image.color: #5c5c61

menu.border.width: 1
menu.border.color: #26262a
menu.title.bg: flat solid
menu.title.bg.color: #161618
menu.title.text.color: #f4f4f0
menu.items.bg: flat solid
menu.items.bg.color: #161618
menu.items.text.color: #f4f4f0
menu.items.disabled.text.color: #5c5c61
menu.items.active.bg: flat solid
menu.items.active.bg.color: #d4ff3a
menu.items.active.text.color: #0e0e0f
menu.separator.color: #26262a

osd.border.width: 1
osd.border.color: #26262a
osd.bg: flat solid
osd.bg.color: #161618
osd.label.text.color: #f4f4f0
osd.hilight.bg: flat solid
osd.hilight.bg.color: #d4ff3a
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #26262a
