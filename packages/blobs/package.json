{
  "name": "@ofa/blobs",
  "version": "0.0.0",
  "private": true,
  "description": "BlobStore adapters (ADR-0047): S3-compatible stores such as Garage, an in-memory store for tests, and Garage's setup. Server-only.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run --passWithNoTests integration"
  },
  "dependencies": {
    "@ofa/core": "workspace:*",
    "aws4fetch": "1.0.20"
  }
}
