{
  "name": "@ofa/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schema, migrations, row-level security and tenant-scoped access. Server-only.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests --exclude \"**/*.integration.test.ts\"",
    "test:integration": "tsx src/scripts/prepare-test-db.ts oneforall_test_db oneforall_test_agents && vitest run --passWithNoTests integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ofa/config": "workspace:*",
    "@ofa/contracts": "workspace:*",
    "@ofa/core": "workspace:*",
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}
