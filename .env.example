# Copy to .env for local development. Values match infra/compose/docker-compose.dev.yml.
# The schema that validates these lives in packages/config/src/env.ts.

NODE_ENV=development
# self-host | cloud
OFA_MODE=self-host

# ── Server ───────────────────────────────────────────────────
# Bind to localhost only (ADR-0017). Inside the self-host container this is 0.0.0.0,
# and Docker publishes the port on 127.0.0.1.
HOST=127.0.0.1
PORT=3000
APP_URL=http://localhost:3000
# Vite dev server, allowed as an extra origin in development
WEB_DEV_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────────
# App role: not the table owner, so row-level security applies
DATABASE_URL=postgres://oneforall_app:oneforall_app_dev@127.0.0.1:5432/oneforall
# Owner role: used only to run migrations
DATABASE_MIGRATION_URL=postgres://oneforall:oneforall_dev@127.0.0.1:5432/oneforall

# ── Secrets ──────────────────────────────────────────────────
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=change-me-to-a-random-string-of-32-plus-characters
# 32 random bytes, base64. Encrypts stored secrets such as the OpenRouter key (needed from M2).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_KEY=
# Or keep the key in the OS keychain instead (running from source on a desktop):
# `pnpm vault keychain:store` copies VAULT_KEY there; then set this and remove VAULT_KEY.
# VAULT_KEY_SOURCE=keychain
# Rotating: put the new key in VAULT_KEY and the old one here (comma-separated if
# several), then restart. The app re-wraps every secret with the new key at start
# and logs when the old one can be removed. `pnpm vault keychain:rotate` does it
# all for a key in the keychain.
# VAULT_PREVIOUS_KEYS=

# ── Models ───────────────────────────────────────────────────
# Which provider serves agents (ADR-0022). Each workspace saves its own key in
# Settings; LLM_API_KEY is an optional fallback, handy in development.
LLM_PROVIDER=openrouter
LLM_API_KEY=
# Model chains per tier, comma-separated, best first. Empty keeps the provider's
# defaults (packages/llm/src/providers/<provider>.ts).
LLM_MODELS_FAST=
LLM_MODELS_STANDARD=
LLM_MODELS_STRONG=

# Self-hosted SearXNG for web.search (started by `pnpm infra:up`).
SEARXNG_URL=http://127.0.0.1:8888
# The agents' computer (started by `pnpm infra:up`). These are the development
# defaults; leave them unset to use them. Self-host sets its own token.
# SANDBOX_URL=http://127.0.0.1:7070
# SANDBOX_TOKEN=ofa-sandbox-dev-token
# OTLP/HTTP endpoint for traces, e.g. a local Phoenix. Empty: traces off.
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Inngest ──────────────────────────────────────────────────
INNGEST_DEV=1
INNGEST_BASE_URL=http://127.0.0.1:8288
# Required when running self-hosted Inngest in production mode
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
