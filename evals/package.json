{
  "name": "@ofa/evals",
  "version": "0.0.0",
  "private": true,
  "description": "Agent behaviour evals: golden tasks and red-team cases on fixtures, graded by checks, run against live models.",
  "type": "module",
  "scripts": {
    "eval": "tsx graders/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run --passWithNoTests integration"
  },
  "dependencies": {
    "@ofa/contracts": "workspace:*",
    "@ofa/core": "workspace:*",
    "@ofa/harness": "workspace:*",
    "@ofa/llm": "workspace:*",
    "@ofa/policy": "workspace:*",
    "@ofa/sandbox": "workspace:*",
    "@ofa/tools": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
