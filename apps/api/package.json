{
  "name": "@ofa/api",
  "version": "0.0.0",
  "private": true,
  "description": "Hono API: REST, auth, first-run setup. Serves the web app in self-host mode.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests --exclude \"**/*.integration.test.ts\"",
    "test:integration": "tsx src/scripts/prepare-test-db.ts && vitest run --passWithNoTests integration",
    "db:seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@ofa/config": "workspace:*",
    "@ofa/contracts": "workspace:*",
    "@ofa/core": "workspace:*",
    "@ofa/db": "workspace:*",
    "@ofa/llm": "workspace:*",
    "@ofa/vault": "workspace:*",
    "better-auth": "1.7.6",
    "hono": "4.13.11",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  }
}
