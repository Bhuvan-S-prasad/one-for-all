{
  "name": "@ofa/learn",
  "version": "0.0.0",
  "private": true,
  "description": "The codebase explained (ADR-0051): a guided path, features, walkthroughs and a code explorer built from an index of the source. Static and read-only.",
  "type": "module",
  "scripts": {
    "index": "tsx scripts/index-repo.ts",
    "dev:learn": "tsx scripts/index-repo.ts && vite",
    "build": "tsx scripts/index-repo.ts && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tanstack/react-router": "1.170.40",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@ofa/tailwind-config": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.1"
  }
}
