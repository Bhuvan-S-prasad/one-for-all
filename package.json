{
  "name": "one-for-all",
  "private": true,
  "description": "Self-hosted platform for teams of always-on AI agents",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "eval": "pnpm --filter @ofa/evals eval",
    "vault": "pnpm --filter @ofa/vault vault",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/compose/docker-compose.dev.yml --env-file infra/compose/dev.env up -d --wait",
    "infra:down": "docker compose -f infra/compose/docker-compose.dev.yml --env-file infra/compose/dev.env down",
    "infra:logs": "docker compose -f infra/compose/docker-compose.dev.yml --env-file infra/compose/dev.env logs -f",
    "infra:reset": "docker compose -f infra/compose/docker-compose.dev.yml --env-file infra/compose/dev.env down -v"
  },
  "devDependencies": {
    "@ofa/eslint-config": "workspace:*",
    "@ofa/tsconfig": "workspace:*",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "turbo": "2.11.5",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
